ENV=development
APP_NAME=Smriti API
API_V1_PREFIX=/api/v1
DEBUG=true

DATABASE_URL=postgresql://smriti:smriti_dev@localhost:5432/smriti_dev

JWT_SECRET_KEY=replace-with-a-32-byte-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
ELDERLY_ACCESS_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS=30

STORAGE_PROVIDER=supabase
STORAGE_BUCKET=smriti-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL_BASE=

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://app.smriti.in,https://caregiver.smriti.in

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
